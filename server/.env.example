# Copie este arquivo para ".env" (mesma pasta) e ajuste os valores.

# Banco de dados PostgreSQL.
# Neon (produção): copie a "Connection string" do painel do Neon (botão Connect) e cole aqui.
# Ex: postgresql://neondb_owner:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# As tabelas são criadas sozinhas na primeira vez que o servidor sobe (db/migracoes).
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/livro_caixa

# (opcional) quantas conexões simultâneas com o banco — o padrão 5 serve pro plano grátis
# DB_POOL_MAX=5

# (opcional, só pra quem roda os testes) banco de TESTE, que é apagado a cada execução.
# O usuário desse banco precisa poder criar papéis (CREATEROLE), como o dono do banco no Neon.
# TEST_DATABASE_URL=postgresql://app:app@127.0.0.1:5432/livro_teste

# Porta em que a API/servidor vai rodar
PORT=3000

# Segredo usado para assinar os tokens de login (JWT).
# Troque por qualquer texto longo e aleatório antes de usar em produção.
JWT_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio

# Client ID e Client Secret do Google, usados pelo botão "Continuar com
# Google" e pela sincronização com a Google Agenda.
# Gere em https://console.cloud.google.com/apis/credentials (veja o README).
# Deixar em branco não quebra nada: o botão de login com Google some sozinho,
# e em Configurações > Google Agenda aparece o link de agenda por .ics como
# alternativa (não depende de nenhuma dessas duas chaves).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA do painel (assistente flutuante, sugestão de mensagem e de tarefa, insights do
# funil, IA proativa). Provedores possíveis — basta preencher UM:
#
#   1) Google Gemini — tem plano gratuito. Chave em https://aistudio.google.com/apikey
#   2) Groq — plano gratuito. Chave em https://console.groq.com/keys
#   3) Anthropic (Claude) — pago por uso. Chave em https://console.anthropic.com/settings/keys
#
# Se houver mais de uma chave, vale a ordem Gemini > Groq > Anthropic (ou o que
# IA_PROVEDOR disser). Sem nenhuma chave a IA fica desligada: a bolinha do assistente,
# os botões de sugestão, os insights e as opções de IA do WhatsApp somem da tela, e o
# resto do painel funciona normalmente.
GEMINI_API_KEY=
# Modelo do Gemini (opcional). Padrão: gemini-3.5-flash-lite
GEMINI_MODEL=
GROQ_API_KEY=
# Modelo do Groq (opcional). Padrão: openai/gpt-oss-120b
GROQ_MODEL=
ANTHROPIC_API_KEY=
# Só preciso se tiver mais de uma chave: "gemini", "groq" ou "anthropic"
IA_PROVEDOR=

# Token de verificação do webhook do WhatsApp Business (você escolhe o valor —
# é o mesmo que você vai colar no painel do Meta ao cadastrar o webhook).
WHATSAPP_VERIFY_TOKEN=

# Token de verificação do webhook de captação de leads via Instagram/Facebook
# (você escolhe o valor — é o mesmo que vai colar no painel do Meta ao cadastrar o webhook).
INSTAGRAM_VERIFY_TOKEN=

# Alerta de falha crítica via Telegram (opcional, mas recomendado) — avisa você
# na hora se o servidor travar ou o banco cair. Gratuito e sem verificação de
# empresa nenhuma, ao contrário do WhatsApp Business. Veja o passo a passo
# completo em server/utils/telegramAlerta.js.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# E-mail (Resend) — liga o "Esqueci minha senha" e o backup semanal por e-mail.
# Crie a conta grátis em https://resend.com, verifique seu domínio e gere uma chave de API.
# Em branco não quebra nada: o link "Esqueci minha senha" some da tela de login.
RESEND_API_KEY=
# Remetente. Ex: Livro-Caixa <nao-responda@seudominio.com.br> (o domínio precisa estar verificado no Resend)
EMAIL_FROM=
# Endereço público do painel, sem barra no final. É o que vai no link do e-mail.
# Ex: https://SEU-APP.onrender.com
APP_URL=

# ---------------------------------------------------------------------------
# Notificações push (avisos de tarefa e de mensagem recebida, mesmo com o app fechado).
# Gere o par de chaves UMA vez, no seu computador: npx web-push generate-vapid-keys
# Em branco não quebra nada: a opção "Notificações" mostra que não está disponível.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# "mailto:seu@email.com" — se ficar em branco, usa o APP_URL
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Segurança dos webhooks da Meta (WhatsApp e Instagram): "Segredo do app", em
# developers.facebook.com → seu app → Configurações → Básico. Com ele preenchido, o painel só
# aceita webhooks realmente assinados pela Meta. Em branco = aceita tudo (como antes).
META_APP_SECRET=
# Versão da Graph API da Meta (padrão v22.0). Revise uma vez por ano.
META_GRAPH_VERSION=
